{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-checker",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // Without this, full-page navigations to /api/* (e.g. clicking a snapshot
    // link, opening a CSV export in a new tab) get intercepted by the SPA
    // fallback and served index.html instead of hitting the Worker — because
    // those requests carry `Sec-Fetch-Mode: navigate`, which Workers Assets
    // treats specially under single-page-application routing.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "browser": {
    "binding": "BROWSER"
  },
  // Run `npx wrangler d1 create link_checker_db` and paste the returned id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "link_checker_db",
      "database_id": "061e3ca3-ca88-4360-9e38-620b261bfb04",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "link-checker-snapshots"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "JOB_QUEUE", "queue": "link-checker-jobs" }
    ],
    "consumers": [
      {
        "queue": "link-checker-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 2
      }
    ]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "development"
    // ACCESS_TEAM_DOMAIN and ACCESS_AUD are NOT set here — they are secrets.
    // After creating a Cloudflare Access application (see README "Access" section),
    // set them in the dashboard (Worker → Settings → Variables and Secrets)
    // or via `npx wrangler secret put ACCESS_TEAM_DOMAIN` / `ACCESS_AUD`.
  }
}
