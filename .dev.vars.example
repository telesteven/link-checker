# Copy to .dev.vars for local `vite` dev.
# Local dev auto-logs in as dev@local.test via DEV_BYPASS_AUTH (set in wrangler.jsonc).
# Set these once you configure a Cloudflare Access application for this Worker,
# then set DEV_BYPASS_AUTH=false in wrangler.jsonc for production.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=your-access-application-aud-tag
